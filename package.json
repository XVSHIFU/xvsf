{
  "name": "xvsf-blog-tooling",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic validation and content tooling for the xvsf Hugo blog",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "workbench:dev": "node workbench/server.mjs",
    "workbench:build": "node scripts/build-workbench.mjs",
    "workbench:test": "node --test workbench/tests/*.test.mjs",
    "frontmatter:check": "node scripts/frontmatter.mjs --check",
    "frontmatter:write": "node scripts/frontmatter.mjs --write",
    "quality:check": "node scripts/content-quality.mjs --check",
    "quality:report": "node scripts/content-quality.mjs --report",
    "images:audit": "node scripts/content-quality.mjs --images",
    "schedule:check": "node scripts/content-quality.mjs --schedule",
    "schedule:test": "node scripts/test-scheduling.mjs",
    "search:index": "pagefind --site .ci-site/xvsf",
    "taxonomies:seed": "node scripts/seed-taxonomies.mjs",
    "validate:html": "html-validate \".ci-site/xvsf/**/*.html\"",
    "terminal:validate": "node scripts/validate-terminal-site.mjs",
    "terminal:test": "node --test scripts/test-terminal.mjs && node scripts/test-terminal-build.mjs",
    "build:site": "node scripts/build-site.mjs",
    "pages:test": "node --test scripts/test-project-activity.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "html-validate": "11.16.0",
    "pagefind": "1.5.2",
    "remark-parse": "11.0.0",
    "sharp": "0.35.5",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vditor": "4.0.0",
    "yaml": "2.9.1"
  }
}
