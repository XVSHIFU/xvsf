  "components": [
    {
      "name": "主要按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "导出、创建、保存设置或属性、导入新副本与恢复文章或历史版本等明确操作；待上传时显示“保存并继续上传”，颜色继承当前主题。",
      "html": "<button type=\"button\" class=\"ds-primary\">导出 Markdown</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:7px;font:500 12px/1.5 var(--ui);min-height:32px;padding:6px 11px;border:0;border-radius:4px;white-space:nowrap;cursor:pointer;transition:background-color .16s ease-out,color .16s ease-out;background:var(--button);color:var(--on-button,#fff)}.ds-primary:hover{background:var(--button-hover)}.ds-primary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-primary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "文字按钮",
      "kind": "button",
      "refersTo": "button-text",
      "description": "保存、取消、上传重试、移动分类、备份与重新生成预览等次要操作保持透明底色；上传、恢复与批量操作结果保留可见文字说明。",
      "html": "<button type=\"button\" class=\"ds-text\">保存到本机</button>",
      "css": ".ds-text{display:inline-flex;align-items:center;justify-content:center;gap:7px;font:500 12px/1.5 var(--ui);min-height:32px;padding:6px 11px;border:0;border-radius:4px;white-space:nowrap;cursor:pointer;transition:background-color .16s ease-out,color .16s ease-out;background:transparent;color:var(--muted)}.ds-text:hover{background:var(--raised);color:var(--text)}.ds-text:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-text:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-text{transition:none}}"
    },
    {
      "name": "图标按钮",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "面板切换、文章更多菜单与具名对话框关闭等紧凑工作区控制；宽幅 Hugo 预览沿用关闭控制。",
      "html": "<button type=\"button\" class=\"ds-icon\" aria-label=\"收起笔记本\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"1\"/><path d=\"M9 4v16\"/></svg></button>",
      "css": ".ds-icon{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;padding:0;border:0;border-radius:4px;background:transparent;color:var(--muted);cursor:pointer;transition:background-color .16s ease-out,color .16s ease-out}.ds-icon svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:none}.ds-icon:hover{background:var(--raised);color:var(--text)}.ds-icon:focus-visible{outline:2px solid var(--accent);outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-icon{transition:none}}"
    },
    {
      "name": "新建标题字段",
      "kind": "input",
      "refersTo": "field",
      "description": "新建本机草稿时使用的文字字段。",
      "html": "<label class=\"ds-field-label\" for=\"ds-new-title\">文章标题</label><input class=\"ds-field\" id=\"ds-new-title\" placeholder=\"给新文章起个名字\" maxlength=\"90\" required>",
      "css": ".ds-field-label{display:block;font:11px/1.5 var(--ui);color:var(--muted);margin-bottom:6px}.ds-field{width:100%;min-height:33px;padding:5px 8px;font:12px/1.5 var(--ui);background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:4px;caret-color:var(--accent)}.ds-field::placeholder{color:var(--muted)}.ds-field:focus-visible{outline:2px solid var(--accent);outline-offset:-2px;box-shadow:none}"
    },
    {
      "name": "工作区搜索",
      "kind": "input",
      "refersTo": "search",
      "description": "顶栏中的文章或分类搜索。",
      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m16 16 5 5\"/></svg><input type=\"search\" placeholder=\"搜索文章\" aria-label=\"搜索文章或分类\"><kbd>Ctrl P</kbd></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:8px;height:30px;width:min(240px,28vw);padding:0 9px;border:1px solid var(--border);border-radius:5px;background:var(--canvas);color:var(--muted)}.ds-search svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:none}.ds-search input{width:100%;min-width:0;border:0;outline:none;background:none;color:var(--text);font:12px/1.5 var(--ui);caret-color:var(--accent)}.ds-search input::placeholder{color:var(--muted);opacity:1}.ds-search:focus-within{outline:2px solid var(--accent);outline-offset:-2px}.ds-search input:focus-visible{outline:none;box-shadow:none}.ds-search kbd{font:12px var(--ui);white-space:nowrap;color:var(--muted);border:1px solid var(--border);padding:1px 4px;border-radius:3px}@media(max-width:760px){.ds-search kbd{display:none}}"
    },
    {
      "name": "分类笔记本与文件行",
      "kind": "nav",
      "refersTo": "notebook",
      "description": "可折叠分类下的选中文档行，共享工作区状态色；侧栏底部并列导入与管理入口，在移动抽屉中继续可用。",
      "html": "<details class=\"ds-notebook\" open><summary><svg class=\"ds-chevron\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m9 5 7 7-7 7\"/></svg><span class=\"ds-notebook-name\">文章分类</span><span class=\"ds-count\">1</span></summary><button type=\"button\" class=\"ds-file ds-file-active\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 3h9l5 5v13H5zM14 3v6h5M8 13h8M8 17h6\"/></svg><span>文章标题</span><span class=\"ds-draft\" aria-label=\"有本机草稿\"></span></button></details>",
      "css": ".ds-notebook{color:var(--text);font:12px/1.5 var(--ui)}.ds-notebook summary{display:flex;align-items:center;gap:8px;min-height:36px;cursor:pointer;padding:6px 8px;list-style:none;border-radius:4px;user-select:none}.ds-notebook summary::-webkit-details-marker{display:none}.ds-notebook summary:hover{background:var(--raised)}.ds-notebook svg{fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:none}.ds-chevron{width:13px;height:13px}.ds-notebook[open] .ds-chevron{transform:rotate(90deg)}.ds-notebook-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-count{font-size:11px;font-variant-numeric:tabular-nums;color:var(--muted)}.ds-file{display:flex;gap:8px;align-items:center;width:100%;min-height:34px;text-align:left;padding:7px 10px 7px 30px;border:0;border-radius:3px;background:transparent;color:var(--muted);font:12px/1.5 var(--ui);cursor:pointer;transition:background-color .16s ease-out,color .16s ease-out}.ds-file svg{width:14px;height:14px}.ds-file span:first-of-type{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-file:hover{background:var(--raised);color:var(--text)}.ds-file-active{background:var(--selected);color:var(--text)}.ds-draft{width:5px;height:5px;border-radius:50%;background:var(--accent)}.ds-notebook summary:focus-visible,.ds-file:focus-visible{outline:2px solid var(--accent);outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-file{transition:none}}"
    },
    {
      "name": "当前文档标签",
      "kind": "nav",
      "refersTo": "tab-active",
      "description": "编辑表面色、顶部蓝线与独立关闭操作标记当前文章。",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"已打开的文章\"><div class=\"ds-tab-item\"><button class=\"ds-tab-select\" type=\"button\" role=\"tab\" aria-selected=\"true\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 3h9l5 5v13H5zM14 3v6h5M8 13h8M8 17h6\"/></svg><span>文章标题</span></button><button type=\"button\" class=\"ds-tab-close\" aria-label=\"关闭文章标题\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m6 6 12 12M6 18 18 6\"/></svg></button></div></div>",
      "css": ".ds-tabs{display:flex;height:39px;background:var(--canvas);border-bottom:1px solid var(--border)}.ds-tab-item{display:flex;align-items:center;position:relative;min-width:125px;max-width:245px;flex:none;background:var(--surface);border-right:1px solid var(--border)}.ds-tab-item:before{content:\"\";position:absolute;top:0;left:0;right:0;height:1px;background:var(--accent)}.ds-tab-select{height:100%;padding:0 7px 0 15px;display:flex;align-items:center;gap:8px;min-width:0;border:0;background:transparent;color:var(--text);font:12px/1.5 var(--ui);cursor:pointer}.ds-tabs svg{fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:none}.ds-tab-select svg{width:14px;height:14px;color:var(--accent)}.ds-tab-select span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-tab-close{display:inline-flex;align-items:center;justify-content:center;width:25px;height:25px;margin:0 6px 0 auto;padding:0;flex:none;border:0;border-radius:4px;background:transparent;color:var(--muted);cursor:pointer;transition:background-color .16s ease-out,color .16s ease-out}.ds-tab-close svg{width:13px;height:13px}.ds-tab-close:hover{background:var(--raised);color:var(--text)}.ds-tab-select:focus-visible,.ds-tab-close:focus-visible{outline:2px solid var(--accent);outline-offset:2px}@media(max-width:760px){.ds-tab-item{max-width:210px}}@media(prefers-reduced-motion:reduce){.ds-tab-close{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "熟悉的写作工作台",
    "overview": "本规范只适用于此目录中的 Vditor 写作体验原型。界面遵循用户选定的 SiYuan / VS Code 式工作区：紧凑导航、连续的编辑表面、明确的选中状态，让文章分类、已打开的文档和当前写作内容保持可见。它不定义父级博客的全局设计。\n\n表面以中性深浅层次和细分隔线组织空间，蓝色标记选择、焦点与主要操作。系统无衬线字体承担工作区与正文，等宽字体用于代码。没有独立图像概念稿；本记录提取自已实现的 style.css、index.html、app.mjs、image-ui.mjs 和 workspace-ui.mjs。",
    "keyCharacteristics": [
      "分类笔记本与多文档标签构成连续工作区。",
      "深浅主题共享组件形状、层次与交互。",
      "界面紧凑，编辑正文保留更宽松的行距。"
    ],
    "rules": [
      {
        "name": "The State Color Rule",
        "body": "蓝色用于当前文档、可操作内容和键盘焦点；绿色用于本机状态与图床令牌已配置提示，不代表上传权限已验证。",
        "section": "colors"
      },
      {
        "name": "The Reading Rhythm Rule",
        "body": "导航标签保持紧凑，编辑正文使用独立的字号与行距；不把界面标签密度带入正文。",
        "section": "typography"
      },
      {
        "name": "The Panel First Rule",
        "body": "常驻面板依靠表面色和分隔线划分；投影只服务于浮层通知和移动端抽屉。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 保持分类行、文档行和标签页的悬停、选中与键盘焦点可区分。",
      "Do 同步工作区和 Vditor 的明暗主题，并使用主题变量承载颜色。",
      "Do 用 SVG 线图标辅助文字，给独立图标按钮提供可访问名称。"
    ],
    "donts": [
      "Don't 把此局部原型规范扩展为父级博客的全局设计规则。",
      "Don't 为常驻编辑面板增加装饰性卡片、营销式大标题或投影。",
      "Don't 让示例说明先于文档主标题；示例身份保留在侧栏标记与标题下元信息中。"
    ]
  }
}
