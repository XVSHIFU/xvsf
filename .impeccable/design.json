      "html": "<nav class=\"ds-nav\" aria-label=\"主导航\"><a class=\"ds-brand\" href=\"/xvsf/\">xvsf</a><div class=\"ds-nav-links\"><a href=\"/xvsf/posts/\" aria-current=\"page\">文章</a><a href=\"/xvsf/projects/\">项目</a><a href=\"/xvsf/links/\">友链</a><a href=\"/xvsf/about/\">关于</a><details class=\"ds-more\"><summary>更多 <svg viewBox=\"0 0 16 16\" width=\"12\" height=\"12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"m4 6 4 4 4-4\"/></svg></summary><div class=\"ds-dropdown\"><a href=\"/xvsf/categories/\">文章分类</a><a href=\"/xvsf/archives/\">时间归档</a><a href=\"/xvsf/notes/\">随记</a><a href=\"/xvsf/random/\">手气不错</a></div></details></div><a class=\"ds-nav-icon\" href=\"/xvsf/search/\" aria-label=\"搜索文章\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m16 16 5 5\"/></svg></a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:20px;min-height:64px;font-family:var(--font-heading, 'Inter', 'Noto Sans SC', system-ui, -apple-system, sans-serif);color:var(--primary,#1a1b1c)}.ds-nav a{color:inherit;text-decoration:none}.ds-brand{font-size:25px;font-weight:700;letter-spacing:-1px}.ds-nav-links{display:flex;gap:22px;align-items:center;margin:0 auto 0 10px;font-size:14px;white-space:nowrap}.ds-nav [aria-current=\"page\"]{color:var(--cat-blue,#366593);text-decoration:underline;text-underline-offset:7px}.ds-nav-icon{display:grid;place-items:center;width:34px;height:34px;border-radius:8px}.ds-nav-icon:hover,.ds-more summary:hover{background:var(--cat-wash,#e8eff6)}.ds-more{position:relative}.ds-more summary{display:flex;align-items:center;gap:5px;height:34px;line-height:1;list-style:none;cursor:pointer;border-radius:6px;padding:0 7px}.ds-more summary svg{display:block;transition:transform .18s ease-out}.ds-more[open] summary svg{transform:rotate(180deg)}.ds-more summary::-webkit-details-marker{display:none}.ds-dropdown{position:absolute;right:0;top:100%;z-index:1;min-width:150px;padding:7px;background:var(--entry,rgb(255,255,255));border:1px solid var(--cat-border,#d0d9e3);border-radius:10px;box-shadow:0 10px 25px #12243b18}.ds-dropdown a{display:block;padding:9px 13px;border-radius:5px;line-height:1.5}.ds-dropdown a:hover{background:var(--cat-wash,#e8eff6)}.ds-nav :is(a,summary):focus-visible{outline:2px solid var(--cat-blue,#366593);outline-offset:-2px;border-radius:5px}@media(max-width:700px){.ds-nav{flex-wrap:wrap;gap:12px;padding-block:10px;line-height:1.6}.ds-brand{margin-right:auto}.ds-nav-links{order:3;width:100%;justify-content:space-between;margin:0;gap:12px;font-size:13px}}@media(prefers-reduced-motion:reduce){.ds-more summary svg{transition:none}}"
